#include <Test/Common/Evaluate.h>

#define T_${TYPE}

TEST_F(Aggregator_${TYPE}, Evaluate_NormalFunc)
{
	DECL_PH_SET_${TYPE}(*m_tree);
	TestNormalFunc(*m_tree, m_class, layer0, layer1, layer2);
}
