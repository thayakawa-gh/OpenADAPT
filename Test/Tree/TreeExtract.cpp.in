#include <Test/Common/Extract.h>

#define T_${TYPE}

TEST_F(Aggregator_${TYPE}, Extract_Simple)
{
	DECL_PH_SET_${TYPE};
	TestSimpleExtract(*m_tree, m_class, layer0, layer1, layer2);
}
TEST_F(Aggregator_${TYPE}, Extract_FilterConfirmation)
{
	DECL_PH_SET_${TYPE};
	TestFilterComfirmation(*m_tree, m_class, layer0, layer1, layer2);
}
TEST_F(Aggregator_${TYPE}, Extract_Filtered)
{
	DECL_PH_SET_${TYPE};
	TestFilteredExtract(*m_tree, m_class, layer0, layer1, layer2);
}
#if !defined(T_DJTree2) && !defined(T_DJTree1_2)
TEST_F(Aggregator_${TYPE}, Extract_Bugcheck)
{
	DECL_PH_SET_${TYPE};
	TestExtractBugcheck(*m_tree, m_class, layer0, layer1, layer2);
}
#endif
#if defined(T_DTree) || defined(T_STree)
TEST_F(Aggregator_${TYPE}, Extract_AllFields)
{
	DECL_PH_SET_${TYPE};
	TestExtractAllFields(*m_tree, m_class, layer0, layer1, layer2);
}
TEST_F(Aggregator_${TYPE}, Extract_AllFieldsPlusAlpha)
{
	DECL_PH_SET_${TYPE};
	TestExtractAllFieldsPlusAlpha(*m_tree, m_class, layer0, layer1, layer2);
}
TEST_F(Aggregator_${TYPE}, Extract_Filtered_AllFields)
{
	DECL_PH_SET_${TYPE};
	TestFilteredExtractAllFields(*m_tree, m_class, layer0, layer1, layer2);
}
